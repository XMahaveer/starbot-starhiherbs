{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/leads.js": {
      "maxDuration": 10
    }
  },
  "env": {
    "ANTHROPIC_API_KEY": "@anthropic_api_key",
    "RESEND_API_KEY": "@resend_api_key",
    "LEADS_EMAIL": "@leads_email"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
